{
  "name": "@wengjjpaul/apple-notes-mcp",
  "version": "0.1.0",
  "description": "MCP server that manages Apple Notes via macOS AppleScript.",
  "license": "MIT",
  "author": "wengjjpaul",
  "type": "module",
  "bin": {
    "apple-notes-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
